# 运行环境：dev / test / prod
ENV=dev

# 数据库：本地默认 SQLite；公网部署时替换为 postgresql://...
DATABASE_URL=sqlite:///./guangxi.db

# 金句模型：fake（不联网，固定输出）或 real（OpenAI 协议接口）
MODEL_PROVIDER=fake

# 以下三项仅 MODEL_PROVIDER=real 时需要
# 任何 OpenAI 协议兼容服务均可：填对应 Base URL 与模型名
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=

# 单次模型调用超时（秒）
MODEL_TIMEOUT_SECONDS=15

# 金句最大字数（含标点）；自由回答最大字数
QUOTE_MAX_CHARS=50
ANSWER_MAX_CHARS=500

# 允许的前端来源，逗号分隔；演示期可用 *
ALLOW_CORS_ORIGINS=*
